<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="MainViewButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:backgroundTint">@color/main_button_background</item>
        <item name="cornerRadius">@dimen/mainCorner_radius</item>
        <item name="android:textSize">@dimen/mainText_size</item>
        <item name="android:textColor">@color/main_button_color_text</item>
        <item name="textAllCaps">false</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">500</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/mainIcon_padding</item>
        <item name="iconTint">@color/main_icon_color</item>
        <item name="android:elevation">0dp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="SettingViewButton" >
        <item name="android:textColor">@color/setting_button_color_text</item>
        <item name="android:textSize">@dimen/settingText_size</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>


    <style name="Search_Line">
        <item name="android:textColor">@color/main_button_color_text</item>
        <item name="android:textColorHint">@color/search_line_content</item>
        <item name="android:background">@null</item>
        <item name="android:textCursorDrawable">@drawable/text_cursor</item>
        <item name="android:textSize">@dimen/settingText_size</item>
        <item name="android:drawableTint">@color/search_line_content</item>
    </style>

    <style name="TextAppearance_TabWidget">
        <item name="android:textSize">@dimen/tabSizeText</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textColor">@color/setting_header_text</item>
    </style>

    <style name="text_bottom_nav">
        <item name="android:textSize">@dimen/searchText_size</item>
        <item name="android:font">@font/ys_display_regular</item>
        <item name="textAllCaps">false</item>
    </style>



    <style name="ButtonUpdate" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/update_button</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">54dp</item>
        <item name="backgroundTint">@color/setting_header_text</item>
    </style>

    <style name="Titles" >
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textColor">?attr/colorAccent</item>
        <item name="android:singleLine">true</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>

    </style>

    <style name="TitlesButton" >
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="tint">?attr/itemTextColor</item>

    </style>

    <style name="AddPlaylistInputEditTextStyle" parent="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">54dp</item>
        <item name="boxCollapsedPaddingTop">0dp</item>
        <item name="endIconMode">clear_text</item>
        <item name="android:textColorHint">?attr/colorAccent</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
    </style>
    
    <style name="MyTitleStyle">
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">22dp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="CustomShapeImage" parent="@style/ThemeOverlay.MaterialComponents">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="PlaylistItem">
        <item name="android:textSize">12sp</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textColor">@color/colorInactiveBottomNavigation</item>
    </style>

</resources>
