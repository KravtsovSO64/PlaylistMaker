<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundApp">

    <Button
        style="@style/MainViewButton"
        android:id="@+id/buttonCreatePlaylist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/settingIcon_marginEnd"
        android:padding="6dp"
        android:paddingLeft="8dp"
        android:backgroundTint="@color/setting_header_text"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="32dp"
        android:text="@string/buttonCreatePlaylist"
        android:textColor="@color/update_button"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:visibility="visible"/>

    <ImageView
        android:id="@+id/mediaViewHolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="116dp"
        android:layout_gravity="center_horizontal"
        android:src="@drawable/ic_not_found"
        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/ys_display_medium"
        android:textColor="@color/search_holder_trackName"
        android:textSize="19sp"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:layout_marginTop="252dp"
        android:text="@string/mediaPlaylistHolder"
        android:visibility="visible"/>

</FrameLayout>