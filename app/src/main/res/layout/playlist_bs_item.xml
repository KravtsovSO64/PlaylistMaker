<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="61dp"
    android:layout_marginBottom="8dp"
    android:layout_marginHorizontal="12dp"
    android:fitsSystemWindows="true"
    android:focusable="true"
    android:clickable="true"
    android:showDividers="middle"
    android:orientation="horizontal"
    android:background="@android:color/transparent"
    android:gravity="center_vertical">

    <androidx.cardview.widget.CardView
        android:id="@+id/playlist_cover_card"
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:cardCornerRadius="8dp"
        app:layout_constraintDimensionRatio="1:1">

        <ImageView
            android:id="@+id/playlist_cover_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            />

    </androidx.cardview.widget.CardView>



    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical"
        tools:ignore="RtlSymmetry">

        <TextView  style="@style/Title"
            android:id="@+id/playlist_name"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            tools:text="Наименование"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            tools:ignore="RtlSymmetry">

            <TextView style="@style/Description"
                android:id="@+id/playlist_count"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                tools:text="Колличество треков"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>