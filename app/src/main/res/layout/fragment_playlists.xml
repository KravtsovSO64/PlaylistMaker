<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundApp">


    <Button   style="@style/MainViewButton"
        android:id="@+id/buttonCreatePlaylist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/settingIcon_marginEnd"
        android:paddingHorizontal="8dp"
        android:backgroundTint="@color/setting_header_text"
        android:text="@string/buttonCreatePlaylist"
        android:textSize="14sp"
        android:letterSpacing="0"
        android:textAllCaps="false"
        android:textColor="@color/update_button"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/horizontal_border"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="83dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/left_border"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="8dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/right_border"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/right_border"
        app:layout_constraintStart_toStartOf="@+id/left_border"
        app:layout_constraintTop_toTopOf="@+id/horizontal_border"
        android:visibility="visible"
        tools:listitem = "@layout/playlist_item" />

    <ImageView
        android:id="@+id/nothing_found_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_gravity="center_horizontal"
        android:src="@drawable/ic_not_found"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@+id/horizontal_border"
        />

    <TextView
        android:id="@+id/nothing_found_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/ys_display_medium"
        android:textColor="@color/search_holder_trackName"
        android:textSize="19sp"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:layout_marginTop="166dp"
        android:text="@string/mediaPlaylistHolder"
        app:layout_constraintTop_toBottomOf="@+id/horizontal_border"
        android:visibility="visible"/>

</androidx.constraintlayout.widget.ConstraintLayout>