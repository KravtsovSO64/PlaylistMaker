<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context="com.practicum.playlistmaker.ui.media.playlist.CreatePlaylistFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_container"
        android:layout_width="0dp"
        android:layout_height="56dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/arrowBackPlayer"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:title="Новый плейлист"
            app:titleMarginStart="12dp"
            app:titleTextAppearance="@style/MyTitleStyle"
            app:navigationIcon="@drawable/ic_arrow_back">
        </androidx.appcompat.widget.Toolbar>



    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/header_container"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/leftBorder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_begin="17dp" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/rightBorder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_end="16dp"/>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/add_photo"
                android:layout_width="312dp"
                android:layout_height="312dp"
                android:layout_marginTop="32dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/rounded_rectangle"
                android:scaleType="fitXY"
                app:layout_constraintEnd_toStartOf="@+id/rightBorder"
                app:layout_constraintStart_toStartOf="@+id/leftBorder"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/CustomShapeImage" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/playlistNameInputLayout"
                style="@style/AddPlaylistInputEditTextStyle"
                android:layout_marginTop="32dp"
                android:hint="@string/name_playlist"
                android:textColorHint="@color/colorInactiveBottomNavigation"
                app:boxCollapsedPaddingTop="0dp"
                app:layout_constraintEnd_toStartOf="@+id/rightBorder"
                app:layout_constraintStart_toStartOf="@+id/leftBorder"
                app:layout_constraintTop_toBottomOf="@+id/add_photo">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:inputType="text" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/playlistDescriptionInputLayout"
                style="@style/AddPlaylistInputEditTextStyle"
                android:layout_marginTop="16dp"
                android:hint="@string/Description"
                android:textColorHint="@color/colorInactiveBottomNavigation"
                app:layout_constraintEnd_toStartOf="@+id/rightBorder"
                app:layout_constraintStart_toStartOf="@+id/leftBorder"
                app:layout_constraintTop_toBottomOf="@+id/playlistNameInputLayout">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_description"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:inputType="text" />

            </com.google.android.material.textfield.TextInputLayout>

          <com.google.android.material.button.MaterialButton
              android:id="@+id/button_create"
              android:layout_width="match_parent"
              android:layout_height="44dp"
              android:layout_marginTop="100dp"
              android:layout_marginHorizontal="16dp"
              android:backgroundTint="@color/button_create"
              android:text="@string/create"
              android:textSize="16sp"
              android:fontFamily="@font/ys_display_medium"
              android:textAllCaps="false"
              android:letterSpacing="0"
              android:enabled="false"
              android:background="@drawable/ic_button_create_playlist"
              app:layout_constraintTop_toBottomOf="@+id/playlistDescriptionInputLayout"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintEnd_toEndOf="parent">

          </com.google.android.material.button.MaterialButton>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>